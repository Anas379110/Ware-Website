---
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CityIllustration from '../components/CityIllustration.astro';
import {isPublished,sortByDateDesc} from '../lib/content';
const articles=sortByDateDesc(await getCollection('articles',isPublished));
const lead=articles[0];
---
<BaseLayout title="الرئيسية"><section class="section-heading"><div><span class="eyebrow">WARE  اقتصاد وأعمال</span><h1>الخليج في سياقه</h1></div><p>قراءة تبدأ بالسؤال وتعود إلى المصدر</p></section><div class="editorial-grid"><section>{lead?<article class="lead-story"><CityIllustration/><div class="lead-content">{lead.data.syntheticDemo&&<div class="demo-badge">مثال تجريبي وليس خبرا حقيقيا</div>}<span class="category">{lead.data.country.replace('_',' ')}  {lead.data.type.replace(/_/g,' ')}</span><h2><a href={`/article/${lead.id}`}>{lead.data.title}</a></h2><p>{lead.data.excerpt}</p><div class="article-meta"><time datetime={lead.data.publishDate.toISOString()}>{new Intl.DateTimeFormat('ar',{dateStyle:'long'}).format(lead.data.publishDate)}</time><span>المصادر داخل المقال</span></div></div></article>:<article class="empty-feature"><span class="eyebrow">المحتوى قيد الإعداد</span><h2>مساحة للفهم<br/>قبل ازدحام العناوين</h2><p>لا توجد مقالات منشورة بعد وتظهر هنا المواد بعد إضافتها ومراجعتها مع مصادرها وتواريخ بياناتها</p><CityIllustration/></article>}</section><aside class="sidebar"><span class="eyebrow">خريطة القراءة</span><h2>اختر نطاقك</h2>{[['السعودية','/country/السعودية'],['الإمارات','/country/الإمارات'],['قطر والكويت',null]].map(([label,href],i)=><div class="side-item"><span class="index-number">0{i+1}</span><h3>{href?<a href={href}>{label}</a>:label}</h3>{!href&&<p><a href="/country/قطر">صفحة قطر</a> <a href="/country/الكويت">صفحة الكويت</a></p>}</div>)}<div class="reader-note"><strong>ملاحظة للقارئ</strong>هذه نسخة عرض تجريبية بلا أسعار مباشرة أو توصيات شراء وبيع وبلا إعلانات فعلية</div></aside></div>{articles.length>1&&<section><div class="section-heading" style="margin-top:40px"><h2>المزيد من القراءات</h2></div><div class="story-grid">{articles.slice(1,10).map(entry=><ArticleCard entry={entry}/>)}</div></section>}<nav class="country-band" aria-label="الدول"><span class="eyebrow">الدول</span>{['السعودية','الإمارات','قطر','الكويت'].map(c=><a href={`/country/${c}`}>{c}</a>)}</nav></BaseLayout>
