---
import '../styles/global.css';
import '../styles/editorial.css';
export interface Props { title: string; description?: string; }
const { title, description = 'Ware، اقتصاد وأعمال الخليج العربي' } = Astro.props;
const links = [ ['الرئيسية','/'], ['السعودية','/country/السعودية'], ['الإمارات','/country/الإمارات'], ['قطر','/country/قطر'], ['الكويت','/country/الكويت'], ['عن Ware','/about'] ];
const current = decodeURI(Astro.url.pathname).replace(/\/$/, '') || '/';
---
<!doctype html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content="noindex,nofollow"/><title>{title} | Ware</title></head><body>
<a class="skip" href="#main">انتقل إلى المحتوى</a>
<div class="preview-note">نسخة عرض تجريبية وليست خدمة إخبارية ولا تتضمن بيانات سوق مباشرة</div>
<header><div class="wrap"><div class="topline"><span>اقتصاد الخليج  أدلة وقراءات</span><span>وضوح في العرض وسياق قبل الأرقام</span></div><div class="masthead"><a href="/" aria-label="Ware، الرئيسية"><div class="wordmark" lang="en" dir="ltr">Ware</div><div class="strap">اقتصاد الخليج بقراءة أوضح</div></a><p class="masthead-note">مساحة اقتصادية تحت التطوير تجمع الخبر ودليله وسياقه في تجربة قراءة عربية</p></div></div><div class="nav-row"><nav class="wrap primary-nav desktop-nav" aria-label="التنقل الرئيسي">{links.map(([label,href])=><a href={href} aria-current={current===href?'page':undefined}>{label}</a>)}</nav><details class="wrap mobile-menu"><summary>الأقسام والدول</summary><nav aria-label="تنقل الهاتف">{links.map(([label,href])=><a href={href} aria-current={current===href?'page':undefined}>{label}</a>)}</nav></details></div></header>
<main id="main" class="wrap" tabindex="-1"><slot/></main>
<footer class="footer"><div class="wrap"><div class="footer-main"><div><div class="wordmark" lang="en" dir="ltr">Ware</div><p>اقتصاد وأعمال الخليج العربي</p></div><nav class="footer-links" aria-label="روابط معلومات الموقع"><a href="/about">من نحن</a><a href="/contact">التواصل</a><a href="/privacy">الخصوصية</a><a href="/terms">الشروط</a></nav></div><div class="footer-bottom">{new Date().getFullYear()} Ware  نسخة عرض تجريبية والمحتوى معلوماتي وليس استشارة مالية</div></div></footer>
</body></html>
