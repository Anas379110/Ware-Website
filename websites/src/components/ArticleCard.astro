---
import { hasStaleFinancialData } from '../lib/content';
import type { CollectionEntry } from 'astro:content';
export interface Props { entry: CollectionEntry<'articles'>; }
const {entry}=Astro.props;
const {title,country,type,publishDate,excerpt}=entry.data;
const stale=hasStaleFinancialData(entry);
---
<a href={`/article/${entry.id}`} class="story-card">{entry.data.syntheticDemo&&<span class="demo-badge">مثال تجريبي وليس خبرا حقيقيا</span>}<span class="category">{country.replace('_',' ')}  {type.replace(/_/g,' ')}</span><h3>{title}</h3><p>{excerpt}</p>{stale&&<span class="stale">بيانات قد تكون قديمة</span>}<time datetime={publishDate.toISOString()}>{new Intl.DateTimeFormat('ar',{dateStyle:'medium'}).format(publishDate)}</time></a>
