---
import AdSlot from '../components/AdSlot.astro';

export interface Props {
  title: string;
  description?: string;
}
const { title, description = "Ware — اقتصاد وأعمال الخليج العربي" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Ware`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Ware</title>
  </head>
  <body class="font-arabic bg-neutral-50 text-neutral-900 min-h-screen flex flex-col">
    <header class="bg-brand text-white">
      <nav class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="text-xl font-bold">Ware</a>
        <div class="flex gap-4 text-sm flex-wrap">
          <a href="/country/السعودية">السعودية</a>
          <a href="/country/الإمارات">الإمارات</a>
          <a href="/country/قطر">قطر</a>
          <a href="/country/الكويت">الكويت</a>
        </div>
      </nav>
    </header>

    <main class="flex-1 max-w-5xl mx-auto px-4 py-8 w-full">
      <AdSlot position="header" />
      <slot />
      <AdSlot position="footer" />
    </main>

    <footer class="bg-brand-dark text-white text-sm">
      <div class="max-w-5xl mx-auto px-4 py-6 flex flex-wrap gap-4 justify-between">
        <p>© {new Date().getFullYear()} Ware — anasnet.com</p>
        <div class="flex gap-4">
          <a href="/about">من نحن</a>
          <a href="/contact">اتصل بنا</a>
          <a href="/privacy">سياسة الخصوصية</a>
          <a href="/terms">شروط الاستخدام</a>
        </div>
      </div>
    </footer>
  </body>
</html>
