---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import {isPublished,sortByDateDesc,filterByCountry} from '../../lib/content';
export async function getStaticPaths(){return ['السعودية','الإمارات','قطر','الكويت'].map(country=>({params:{country}}));}
const {country}=Astro.params;
const filtered=sortByDateDesc(filterByCountry(await getCollection('articles',isPublished),country??''));
---
<BaseLayout title={`اقتصاد ${country}`}><div class="breadcrumbs"><a href="/">الرئيسية</a>  {country}</div><section class="section-heading"><div><span class="eyebrow">قراءات حسب الدولة</span><h1>اقتصاد {country}</h1></div></section>{filtered.length?<div class="story-grid">{filtered.map(entry=><ArticleCard entry={entry}/>)}</div>:<section class="empty-feature"><span class="eyebrow">لا مقالات بعد</span><h2>القراءة التالية تبدأ من هنا</h2><p>لم تُضف مواد منشورة لهذه الدولة ولا نملأ هذه المساحة بأخبار أو أرقام غير متحققة</p><a class="back-link" href="/">العودة إلى الصفحة الرئيسية</a></section>}</BaseLayout>
